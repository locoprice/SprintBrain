{
  "id": "/mobile/",
  "name": "SprintBrain",
  "short_name": "SprintBrain",
  "description": "Your snippets, prompts and Brains on the phone. Save text and links from any app into a Brain.",
  "start_url": "/mobile/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F2F2F7",
  "theme_color": "#1B4FD8",
  "icons": [
    { "src": "/mobile/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/mobile/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/mobile/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/mobile/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
